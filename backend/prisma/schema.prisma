generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(uuid())
  email             String             @unique
  name             String?
  passwordHash     String
  pushToken        String?
  createdAt        DateTime           @default(now())
  sessions         Session[]
  connectedAccounts ConnectedAccount[]
  categories       Category[]
  binanceAccount   BinanceAccount?
  investmentOrders InvestmentOrder[]
  investmentRules  InvestmentRule[]
  investmentPendingActions InvestmentPendingAction[]
  categoryRules    CategoryRule[]
  portfolioSnapshots PortfolioSnapshot[]
}

// Foto diária da carteira de investimentos (corretoras) pra calcular valorização,
// já que o Pluggy não retorna lucro. assets = { [investmentId]: valorAtualBRL }.
model PortfolioSnapshot {
  id        String   @id @default(uuid())
  userId    String
  date      String   // YYYY-MM-DD (1 por usuário por dia)
  total     Float
  assets    Json
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

model Session {
  id               String   @id @default(uuid())
  userId           String
  refreshTokenHash String
  expiresAt        DateTime
  deviceInfo       String?
  usedAt           DateTime?
  revokedAt        DateTime?
  replacedById     String?
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())

  @@index([userId])
}

model ConnectedAccount {
  id               String        @id @default(uuid())
  userId           String
  pluggyItemId     String        @unique
  bankName         String
  customName       String?
  logoUrl          String?
  primaryColor     String?
  consentExpiresAt DateTime?
  status           String        @default("ACTIVE")
  // Corretora (tem investimentos): excluída do saldo e das transações,
  // já que o dinheiro aplicado não é gasto/saldo disponível.
  isInvestment     Boolean       @default(false)
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankAccounts     BankAccount[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([userId])
}

model BankAccount {
  id                 String           @id @default(uuid())
  connectedAccountId String
  externalId         String
  type               String
  subtype            String?
  name               String?
  marketingName      String?
  number             String?
  balance            Float
  currency           String           @default("BRL")
  lastSyncAt         DateTime?
  // Cartão de crédito: próxima data de fechamento e vencimento (vem do creditData da Pluggy).
  // Usado para calcular a fatura aberta no dashboard.
  creditCloseDate    DateTime?
  creditDueDate      DateTime?
  // Dia do mês (1-31) em que a fatura fecha. Configurado MANUALMENTE pelo
  // usuário quando o Pluggy/banco não envia creditData confiável (ex: Mercado Pago).
  // Quando setado, tem prioridade sobre creditCloseDate no cálculo da fatura aberta.
  creditCloseDay     Int?
  // Dia do mês (1-31) em que a fatura VENCE. Usado pra derivar o vencimento e
  // disparar os lembretes de pagamento, já que o balanceDueDate da Pluggy às
  // vezes vem um ciclo atrasado. Configurável pelo usuário.
  creditDueDay       Int?
  // Snapshot do creditData da Pluggy (cartão), pra exibir e notificar.
  minimumPayment     Float?
  creditLimit        Float?
  creditBrand        String?
  connectedAccount   ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)
  transactions       Transaction[]

  @@unique([connectedAccountId, externalId])
}

model Transaction {
  id                 String      @id @default(uuid())
  bankAccountId      String
  externalId         String
  amount             Float
  currency           String      @default("BRL")
  description        String
  alias              String?
  categoryId         String?
  merchantName       String?
  merchantMcc        String?
  paymentMethod      String?
  occurredAt         DateTime
  installmentCurrent Int?
  installmentTotal   Int?
  // null = decisão automática pelo algoritmo
  // true = forçar como assinatura (override positivo)
  // false = forçar fora (override negativo, p.ex. falso positivo)
  isSubscriptionOverride Boolean?
  rawData            Json?
  bankAccount        BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  category           Category?   @relation(fields: [categoryId], references: [id])
  createdAt          DateTime    @default(now())

  @@unique([bankAccountId, externalId])
  @@index([bankAccountId, occurredAt])
  @@index([categoryId])
}

model Category {
  id           String         @id @default(uuid())
  userId       String?
  name         String
  icon         String
  color        String
  isDefault    Boolean        @default(false)
  user         User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  rules        CategoryRule[]

  @@index([userId])
}

model CategoryRule {
  id                  String   @id @default(uuid())
  userId              String
  merchantNamePattern String?
  mcc                 String?
  categoryId          String
  priority            Int      @default(0)
  category            Category @relation(fields: [categoryId], references: [id])
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt           DateTime @default(now())

  @@index([userId])
}

model BinanceAccount {
  id           String            @id @default(uuid())
  userId       String            @unique
  apiKeyEnc    String
  apiSecretEnc String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders       InvestmentOrder[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model InvestmentOrder {
  id               String         @id @default(uuid())
  userId           String
  binanceAccountId String
  asset            String
  amountBrl        Float
  amountAsset      Float?
  orderType        String         @default("MARKET")
  triggerType      String         @default("MANUAL")
  status           String         @default("PENDING")
  executedAt       DateTime?
  errorMessage     String?
  binanceOrderId   String?
  responseData     Json?
  user             User           @relation(fields: [userId], references: [id])
  binanceAccount   BinanceAccount @relation(fields: [binanceAccountId], references: [id])
  createdAt        DateTime       @default(now())

  @@index([userId, createdAt])
}

model InvestmentRule {
  id                String   @id @default(uuid())
  userId            String
  name              String
  active            Boolean  @default(true)

  // Trigger
  triggerType       String                          // 'monthly' | 'weekly' | 'salary_received'
  triggerDay        Int?                            // monthly: 1-31; weekly: 0-6 (dom-sab)
  triggerMinAmount  Float?                          // salary_received: valor mínimo da tx pra contar

  // Action
  actionType        String                          // 'buy_binance' | 'reminder'
  asset             String
  amountBrl         Float

  // Limites de segurança
  maxAmountBrl      Float?                          // hard cap por execução
  maxFiresPerMonth  Int      @default(2)

  // Estado
  firesThisMonth    Int      @default(0)
  firesMonthRef     DateTime?                       // 1º dia do mês atual de referência
  lastFiredAt       DateTime?
  lastError         String?

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pendingActions    InvestmentPendingAction[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId, active])
  @@index([triggerType, active])
}

model InvestmentPendingAction {
  id              String   @id @default(uuid())
  userId          String
  ruleId          String?

  actionType      String                            // 'buy_binance' | 'reminder'
  asset           String
  amountBrl       Float
  status          String   @default("PENDING")      // PENDING | APPROVED | EXECUTED | DISMISSED | EXPIRED | FAILED

  dueAt           DateTime
  approvedAt      DateTime?
  executedAt      DateTime?
  resultMessage   String?
  executedOrderId String?                           // FK opcional pra InvestmentOrder

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rule            InvestmentRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  createdAt       DateTime @default(now())

  @@index([userId, status])
  @@index([status, dueAt])
}
